# Local development settings for the App Service email-triage sample.
# Copy to `.env` and fill in. These mirror the app settings that infra/main.bicep wires
# in Azure. Locally, `dotnet run` reads them (via the DotNetEnv-style test.http and/or
# your shell) and DefaultAzureCredential uses your `az login` identity for connector calls.
#
# Get the connection runtime URLs after a provision:
#   azd env get-values | grep -i RUNTIME_URL
# or from the Connector Namespace connections in the portal / `az connector-namespace`.

# --- Connection runtime URLs (outbound connector calls) ---
OFFICE365_CONNECTION_RUNTIME_URL=
TEAMS_CONNECTION_RUNTIME_URL=
OFFICE365USERS_CONNECTION_RUNTIME_URL=

# --- Teams triage card target ---
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=

# --- Classifier tuning (optional) ---
# Comma-separated senders that are always important.
IMPORTANT_SENDERS=
# Comma-separated in-org domains for the Office 365 Users prefilter. Empty = look up all.
INTERNAL_DOMAINS=

# --- Local-only ---
# Leave AZURE_CLIENT_ID empty locally so DefaultAzureCredential uses your az login.
# AZURE_CLIENT_ID=

# For the CLOUD test.http requests:
# APP_URL=https://<your-app>.azurewebsites.net
