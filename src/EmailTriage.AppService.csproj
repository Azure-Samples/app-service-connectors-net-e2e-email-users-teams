<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EmailTriage.AppService</RootNamespace>
    <UserSecretsId>b6f2b3c9-6f0d-4d3a-9d0b-2f7e5a1c4e88</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed connectors SDK: typed trigger payloads (Office365OnNewEmailTriggerPayload)
         and outbound action clients (Teams / Office365 / Office365Users). Fully portable —
         works in any .NET host, no Functions runtime required. -->
    <PackageReference Include="Azure.Connectors.Sdk" Version="0.11.0-preview.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />

    <!-- OpenTelemetry -> Azure Monitor (App Insights). The ASP.NET Core distro's
         UseAzureMonitor() one-liner auto-instruments incoming requests + outgoing
         HttpClient calls (the connector SDK calls) and exports traces/metrics/logs. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
